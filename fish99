<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,height=device-height,initial-scale=1" />
  <title>GoldFish Final TikTok Edition</title>
  <style>
    :root{
      /* Fond transparent pour le stream */
      --bg: transparent; 
      --glow: rgba(255, 196, 0, 0.4);
    }

    html, body {
      margin:0; width:100%; height:100%;
      background: var(--bg);
      overflow:hidden;
      font-family: 'Arial Black', sans-serif;
    }

    #stage {
      position:relative;
      width:100%; height:100%;
      overflow: hidden;
      background: transparent;
    }

    #fx { position:absolute; inset:0; pointer-events:none; z-index: 5; }

    #fishWrap {
      position:absolute;
      left:50%; top:50%;
      /* Échelle de départ légèrement réduite */
      transform: translate(-50%,-50%) scale(0.8);
      transform-origin: center center;
      filter: drop-shadow(0 10px 30px rgba(0,0,0,0.3));
      will-change: transform;
    }

    /* Animation de brillance à chaque clic */
    .growth-hit {
      animation: growthHit 0.3s ease-out;
    }
    @keyframes growthHit {
      0% { filter: brightness(1); }
      50% { filter: brightness(1.6) drop-shadow(0 0 40px gold); }
      100% { filter: brightness(1) drop-shadow(0 0 15px var(--glow)); }
    }

    /* DESIGN DU POISSON */
    #goldieSVG { width: 450px; height: auto; display: block; overflow: visible; }
    
    #tail { transform-box: fill-box; transform-origin: 100% 50%; animation: tailWag 0.8s ease-in-out infinite alternate; }
    #finSide { transform-box: fill-box; transform-origin: 50% 0%; animation: finWave 1s ease-in-out infinite alternate; }

    @keyframes tailWag { from { transform: rotate(-8deg); } to { transform: rotate(8deg); } }
    @keyframes finWave { from { transform: rotate(-5deg); } to { transform: rotate(12deg); } }

    /* MESSAGE FINAL */
    #deadStamp {
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%,-50%) scale(0);
      color: white; text-align: center; z-index: 10; opacity: 0; pointer-events: none;
    }
    .show-stamp { animation: stampIn 0.5s cubic-bezier(0.17, 0.89, 0.32, 1.49) forwards; }
    @keyframes stampIn {
      0% { transform: translate(-50%,-50%) scale(0); opacity: 0; }
      100% { transform: translate(-50%,-50%) scale(1.2); opacity: 1; text-shadow: 0 0 20px rgba(255,0,0,0.8), 0 0 40px gold; }
    }
  </style>
</head>
<body>

  <div id="stage">
    <canvas id="fx"></canvas>
    
    <div id="fishWrap">
      <svg id="goldieSVG" viewBox="0 0 520 360" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <radialGradient id="gBody" cx="60%" cy="35%" r="80%">
            <stop offset="0%" stop-color="#FFF5B0"/>
            <stop offset="40%" stop-color="#FFB300"/>
            <stop offset="100%" stop-color="#E65100"/>
          </radialGradient>
          <linearGradient id="gFin" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#FFD54F"/>
            <stop offset="100%" stop-color="#FF6D00"/>
          </linearGradient>
          <pattern id="scales" x="0" y="0" width="25" height="25" patternUnits="userSpaceOnUse">
            <circle cx="12" cy="12" r="10" fill="none" stroke="white" stroke-opacity="0.08" stroke-width="1"/>
          </pattern>
        </defs>

        <g id="tail">
          <path d="M110 185 Q40 100 30 185 Q40 270 110 185" fill="url(#gFin)" />
        </g>

        <g id="body">
          <ellipse cx="290" cy="190" rx="180" ry="110" fill="url(#gBody)"/>
          <ellipse cx="290" cy="190" rx="180" ry="110" fill="url(#scales)"/>
          
          <path d="M220 95 Q290 30 380 110 Z" fill="url(#gFin)" opacity="0.8"/>
          <path d="M180 150 Q280 100 400 150" stroke="white" stroke-width="12" stroke-linecap="round" opacity="0.2"/>

          <g id="finSide">
            <path d="M290 210 Q340 220 330 280 Q270 260 290 210" fill="url(#gFin)"/>
          </g>

          <g id="eye">
            <circle cx="385" cy="155" r="24" fill="white"/>
            <circle cx="395" cy="158" r="11" fill="#222"/>
            <circle cx="400" cy="152" r="5" fill="white"/>
          </g>

          <path d="M455 195 Q475 205 455 215" fill="none" stroke="#802000" stroke-width="5" stroke-linecap="round"/>
        </g>
      </svg>
    </div>

    <div id="deadStamp">
      <h1 style="font-size: 80px; margin:0; -webkit-text-stroke: 2px black;">EXPLOSION !</h1>
      <p style="font-size: 25px; margin:0; -webkit-text-stroke: 1px black;">OBJECTIF ATTEINT</p>
    </div>
  </div>

  <script>
    const fishWrap = document.getElementById('fishWrap');
    const canvas = document.getElementById('fx');
    const ctx = canvas.getContext('2d');
    const deadStamp = document.getElementById('deadStamp');

    // Échelle de départ plus petite
    let scale = 0.8; 
    let isDead = false;
    let feedCount = 0;
    // Toujours entre 10 et 15
    let explodeAt = Math.floor(Math.random() * 6) + 10; 
    let particles = [];

    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resize);
    resize();

    class Particle {
      constructor(x, y, color, speed) {
        this.x = x; this.y = y;
        this.vx = (Math.random() - 0.5) * speed;
        this.vy = (Math.random() - 0.5) * speed;
        this.life = 1;
        this.color = color;
        this.size = Math.random() * 6 + 2;
      }
      draw() {
        ctx.globalAlpha = this.life;
        ctx.fillStyle = this.color;
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
        ctx.fill();
        this.x += this.vx; this.y += this.vy;
        this.life -= 0.02;
      }
    }

    function feed() {
      if(isDead) return;
      feedCount++;
      
      // Augmentation réduite pour ne pas flouter à la fin
      // Il finit environ à 2.8 fois sa taille (au lieu de 4 ou 5)
      scale += 0.18; 
      fishWrap.style.transform = `translate(-50%,-50%) scale(${scale})`;
      
      fishWrap.classList.remove('growth-hit');
      void fishWrap.offsetWidth;
      fishWrap.classList.add('growth-hit');

      const rect = fishWrap.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;

      for(let i=0; i<25; i++) {
        particles.push(new Particle(centerX, centerY, 'gold', 12));
      }

      if(feedCount >= explodeAt) {
        explode();
      }
    }

    function explode() {
      isDead = true;
      fishWrap.style.display = 'none';
      
      for(let i=0; i<150; i++) {
        particles.push(new Particle(window.innerWidth/2, window.innerHeight/2, 'orange', 20));
        particles.push(new Particle(window.innerWidth/2, window.innerHeight/2, 'white', 25));
      }
      deadStamp.classList.add('show-stamp');
    }

    function reset() {
      scale = 0.8;
      feedCount = 0;
      isDead = false;
      explodeAt = Math.floor(Math.random() * 6) + 10;
      fishWrap.style.display = 'block';
      fishWrap.style.transform = `translate(-50%,-50%) scale(0.8)`;
      deadStamp.classList.remove('show-stamp');
      particles = [];
    }

    function loop() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      particles = particles.filter(p => p.life > 0);
      particles.forEach(p => p.draw());
      requestAnimationFrame(loop);
    }
    loop();

    window.addEventListener('keydown', (e) => {
      if(e.code === 'F9') feed();
      if(e.code === 'F10') reset();
    });
  </script>
</body>
</html>
